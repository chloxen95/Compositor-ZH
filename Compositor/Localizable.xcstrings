    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 列出所有颜色；颜色只编辑一个色系；点颜色用于调整拾取到的单个颜色。"
          }
        }
      }
    },
    "Hardness": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬度"
          }
        }
      }
    },
    "Height": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度"
          }
        }
      }
    },
    "Height in pixels; the width follows, keeping the proportions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度（像素）；宽度按比例跟随"
          }
        }
      }
    },
    "Hex": {
      "localizations": {
        "zh-Hans": {
