    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上拖移某个颜色，邻近色系会一起移动。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移控制点；点按可添加，双击可删除。"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖移：角度决定色相，距离决定饱和度。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖移可放置参考线，至少画两条。"
          }
        }
      }
    },
    "Drag to resize the panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移可调整面板大小"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移可调整色相与饱和度；双击可重置该色轮。"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖移可抬升或压低该色调范围。拖移底部的分隔点可改变各区域覆盖的色调。"
          }
        }
      }
    },
    "Draw Guides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制参考线"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个粗像素画成实心方块，或画成点阵屏那样的圆点"
          }
        }
      }
    },
    "Draw no line where the picture is darker than this, leaving the screen dark": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面暗于此值处不画线，屏幕保持黑暗"
