      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙并删除"
          }
        }
      }
    },
    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「烘焙」会把当前的蒙版效果写入相关图层的像素；「移除链接」会露出它们的原始像素。两种选择都可以撤销。"
          }
        }
      }
    },
