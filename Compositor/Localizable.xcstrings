    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，在中间调最强。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给最暗的色调加入绿色或洋红。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿较大的形状增加或柔化对比。"
