    "%@ %@ is now available — you have %@. Would you like to download it now?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 现已可用，当前版本为 %@。要现在下载吗？"
          }
        }
      }
    },
    "%@ %@ is ready to install — you have %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 已可安装，当前版本为 %@。"
