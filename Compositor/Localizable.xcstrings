    "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个应用更改了这个项目。你可以恢复到磁盘上的版本（未存储的更改会丢失），或保留当前内容。"
          }
        }
      }
    },
