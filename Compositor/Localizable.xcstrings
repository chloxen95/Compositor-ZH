    "Highlight Priority": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先保护明亮边缘；颜色优先同时降低饱和度；叠加覆盖则均匀压暗边缘。"
          }
        }
      }
    },
    "Highlight Recovery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光恢复"
          }
        }
      }
    },
    "Highlights": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光"
          }
        }
      }
    },
    "Highlights color": {
